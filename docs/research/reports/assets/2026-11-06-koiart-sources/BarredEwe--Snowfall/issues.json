  {
    "url": "https://api.github.com/repos/BarredEwe/Snowfall/issues/2",
    "repository_url": "https://api.github.com/repos/BarredEwe/Snowfall",
    "labels_url": "https://api.github.com/repos/BarredEwe/Snowfall/issues/2/labels{/name}",
    "comments_url": "https://api.github.com/repos/BarredEwe/Snowfall/issues/2/comments",
